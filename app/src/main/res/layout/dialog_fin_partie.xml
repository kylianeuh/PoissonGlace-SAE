<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="850dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="35dp"
    android:background="@drawable/bouton_arrondi_bordure"
    android:backgroundTint="#70BEE9"
    android:gravity="center_horizontal">

    <com.sae402.poissonglobe.PoissonGlaceTextView
        android:id="@+id/txt_titre_termine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/cherry_bomb"
        android:text="@string/titre_termine"
        android:textColor="#FFFFFF"
        android:textSize="55sp" />

    <com.sae402.poissonglobe.PoissonGlaceTextView
        android:id="@+id/txt_message_victoire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:fontFamily="@font/cherry_bomb"
        android:gravity="center"
        android:text=""
        android:textColor="#FFCC00"
        android:textSize="65sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="25dp">

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:id="@+id/txt_popup_equipe_gauche"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cherry_bomb"
            android:gravity="end"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:id="@+id/txt_popup_scores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:fontFamily="@font/cherry_bomb"
            android:gravity="center"
            android:text=" - "
            android:textColor="#FFCC00"
            android:textSize="60sp" />

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:id="@+id/txt_popup_equipe_droite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cherry_bomb"
            android:gravity="start"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="40sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:id="@+id/btn_dialog_accueil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/cherry_bomb"
            android:padding="12dp"
            android:text="@string/btn_accueil"
            android:textColor="#FFFFFF"
            android:textSize="45sp" />
    </LinearLayout>

</LinearLayout>