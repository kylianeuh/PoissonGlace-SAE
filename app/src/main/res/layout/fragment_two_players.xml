<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center_vertical">

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bouton_rond_bordure"
            android:fontFamily="@font/cherry_bomb"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:text="J1"
            android:textAlignment="center"
            android:textColor="#FFD700"
            android:textSize="40sp" />

        <Spinner
            android:id="@+id/spinnerJ1"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="24dp"
            android:layout_weight="1"
            android:background="@drawable/bouton_arrondi_bordure"
            android:dropDownWidth="match_parent"
            android:dropDownVerticalOffset="90dp"
            android:dropDownSelector="@android:color/transparent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:popupBackground="#22A7F0"
            android:textColor="#FFFFFF" />

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:id="@+id/btnAddJ1"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bouton_rond_bordure"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/cherry_bomb"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="+"
            android:textAlignment="center"
            android:textColor="#FFD700"
            android:textSize="60sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bouton_rond_bordure"
            android:fontFamily="@font/cherry_bomb"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:text="J2"
            android:textAlignment="center"
            android:textColor="#FFD700"
            android:textSize="40sp" />

        <Spinner
            android:id="@+id/spinnerJ2"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="24dp"
            android:layout_weight="1"
            android:background="@drawable/bouton_arrondi_bordure"
            android:dropDownWidth="match_parent"
            android:dropDownVerticalOffset="90dp"
            android:dropDownSelector="@android:color/transparent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:popupBackground="#22A7F0"
            android:textColor="#FFFFFF" />

        <com.sae402.poissonglobe.PoissonGlaceTextView
            android:id="@+id/btnAddJ2"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bouton_rond_bordure"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/cherry_bomb"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="+"
            android:textAlignment="center"
            android:textColor="#FFD700"
            android:textSize="60sp" />
    </LinearLayout>
</LinearLayout>